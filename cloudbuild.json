{
  
  "steps": [
    {
    "name": "bash",
    "args": [
        "echo",
        "FROM node:16",
        "WORKDIR /app",
        "COPY package*.json ./",
        "RUN npm install",
        "COPY . .",
        "EXPOSE 8080",
        "CMD [ 'node', 'index.js' ] > Dockerfile"

       ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "-t",
        "us-central1-docker.pkg.dev/dsibrian-dev/quickstart-docker-repo/quickstart-image",
        "."
      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "push",
        "us-central1-docker.pkg.dev/dsibrian-dev/quickstart-docker-repo/quickstart-image"
      ]
    },
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "entrypoint": "gcloud",
      "args": [
        "run",
        "deploy",
        "test-github",
        "--image",
        "us-central1-docker.pkg.dev/dsibrian-dev/quickstart-docker-repo/quickstart-image",
        "--region",
        "us-central1"
      ]
    }
  ],
  "images": [
    "us-central1-docker.pkg.dev/dsibrian-dev/quickstart-docker-repo/quickstart-image"
  ],
  "options": {
    "logging": "CLOUD_LOGGING_ONLY"
  }
}

